# Next.js 服务端：仅固定测试账号使用。真实值放入 .env.local，绝不提交。
ERIS_TEST_USERNAME=
ERIS_TEST_PASSPHRASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ERIS_TEST_DAILY_LIMIT=100

# Supabase：仅填写项目 URL 和 publishable key，不要放 service_role 或 secret key。
# 配置后启用匿名登录、执行 supabase/migrations 下的 SQL，才会自动保存和恢复会话。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅生产环境固定测试账号需要；secret key 只在服务端使用，用于全局额度计数。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 旧 Streamlit 原型仍读取此值。
ERIS_TEST_SESSION_LIMIT=20
