# 测试账号需先运行 scripts/provision-test-account.mjs 写入 Supabase Auth。
# 真实值放入 .env.local，绝不提交。
ERIS_TEST_USERNAME=
ERIS_TEST_PASSPHRASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ERIS_TEST_DAILY_LIMIT=100

# Supabase：仅填写项目 URL 和 publishable key，不要放 service_role 或 secret key。
# 手机号只是登录标识；内部使用不可投递的别名邮箱，无短信验证码。
# 需要 Supabase Email/Password Auth 和服务端 secret key；不要启用 Phone/SMS。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 服务端专用：测试额度与账号 API Key 保存都需要。绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 32 字节随机密钥的 Base64 值。首次设置后应安全备份并保持不变。
ERIS_API_KEY_ENCRYPTION_KEY=

# 旧 Streamlit 原型仍读取此值。
ERIS_TEST_SESSION_LIMIT=20
